# =====================================================================
# Envint Website — Environment Variables Template
# Copy this file to .env.local (never commit .env.local)
# =====================================================================

# ── Database (Neon Postgres) ──────────────────────────────────────────
DATABASE_URL="postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/envint?sslmode=require"

# ── Authentication (Clerk) ────────────────────────────────────────────
# Get from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_xxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_live_xxxxxxxxxxxx"

# Clerk redirect URLs (adjust for admin app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# ── CMS & Preview ─────────────────────────────────────────────────────
# Used to authenticate draft preview requests and cache revalidation
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DRAFT_PREVIEW_SECRET="your-32-byte-hex-secret-here"
REVALIDATION_SECRET_TOKEN="another-32-byte-hex-secret-here"

# ── Public Site URL (used by admin to dispatch revalidation) ──────────
# In production: https://envintglobal.com
# In Netlify preview: https://xxx-envint.netlify.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# ── Upstash Redis (Preview Store) ────────────────────────────────────
# Get from https://console.upstash.com → Create Database → REST API
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXxxxx"

# ── Cron Security ─────────────────────────────────────────────────────
# Shared secret sent in x-cron-secret header by cron runner
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET="your-cron-secret-here"

# ── Analytics (optional) ─────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
