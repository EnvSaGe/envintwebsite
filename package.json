{
  "name": "envint-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm --recursive build",
    "dev:web": "pnpm --filter @envint/web dev",
    "dev:admin": "pnpm --filter @envint/admin dev",
    "check:all": "pnpm --recursive typecheck && pnpm --recursive lint",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "audit": "pnpm audit",
    "generate:redirects": "tsx scripts/generate-redirects.ts",
    "migration:analyze": "tsx scripts/migration-analyze.ts",
    "migration:dry-run": "tsx scripts/migration-dry-run.ts",
    "cms:schema": "tsx scripts/apply-cms-schema.ts",
    "cms:migrate": "tsx scripts/migrate-live-parity-cms.ts",
    "cms:verify": "tsx scripts/verify-cms-database.ts",
    "audit:visual": "tsx scripts/compare-live-local-visuals.ts",
    "audit:interactions": "tsx scripts/verify-live-interactions.ts",
    "audit:cms-adapters": "tsx scripts/verify-cms-public-adapters.ts",
    "cms:sync-page": "tsx scripts/sync-canonical-page.ts",
    "cms:sync-template": "tsx scripts/sync-content-template.ts",
    "audit:inventory": "tsx scripts/verify-public-route-inventory.ts",
    "audit:capture-live": "tsx scripts/capture-live-fidelity.ts",
    "test:all": "tsx scripts/test-all-168-urls.ts",
    "seed": "tsx scripts/seed-all-content.ts",
    "migrate": "tsx scripts/migrate.ts",
    "db:push": "pnpm --filter @envint/db db:push",
    "db:generate": "pnpm --filter @envint/db db:generate"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "dotenv": "^17.4.2",
    "eslint": "^9.20.1",
    "prettier": "^3.5.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0"
  }
}
